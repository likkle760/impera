# ================= IMPERA Webhook Server — fill these in =================

# --- Stripe (Dashboard → Developers → API keys) ---
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
# From: stripe listen --forward-to localhost:4242/webhook  (or your webhook endpoint settings)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# --- Product map: Stripe Price ID -> product info ---
# type: "bot" or "mentorship". key must match your site's bot ids.
PRICE_MAP={"price_1234ABCD":{"key":"scalping","name":"IMPERA Scalping Bot","type":"bot"},"price_5678EFGH":{"key":"gold","name":"IMPERA Gold Bot","type":"bot"},"price_9012IJKL":{"key":"global","name":"IMPERA Global Bot","type":"bot"},"price_3456MNOP":{"key":"mentor-monthly","name":"IMPERA Mentorship — Monthly","type":"mentorship"},"price_7890QRST":{"key":"mentor-lifetime","name":"IMPERA Mentorship — Lifetime","type":"mentorship"}}

# --- Your site + links ---
SITE_URL=https://your-site.com
TELEGRAM_URL=https://t.me/+PwykI4dxBOEzMGFk
SUPPORT_EMAIL=support@impera.com
# Owner inbox for instant sale/booking alerts
ADMIN_NOTIFY_EMAIL=you@example.com

# --- Email sending (Gmail example) ---
# Gmail requires a 16-char App Password: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
MAIL_FROM=IMPERA <you@gmail.com>

# --- Mentorship auto-scheduling ---
MENTOR_SESSION_HOUR=18:00
MENTOR_SESSION_TZ_LABEL=UK time

# --- Admin token for /api/remind (any long random string) ---
ADMIN_TOKEN=change-me-to-something-long-and-random
